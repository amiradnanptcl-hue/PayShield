# All optional — the hackathon demo runs without any of these.

# Anthropic — used by the scoring agent and chase email composer.
# When unset, the app falls back to a deterministic heuristic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SCORING=claude-sonnet-4-6
ANTHROPIC_MODEL_EMAILS=claude-haiku-4-5-20251001

# Companies House — for live (non-demo) lookups.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE=https://api.company-information.service.gov.uk

# Supabase — cache layer (not used by the demo path).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — chase email delivery (mocked in demo mode).
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@payshield.io

# Demo mode — when true, all chase sends are mocked and the live API is
# never called for the five anchor companies.
DEMO_MODE=true
